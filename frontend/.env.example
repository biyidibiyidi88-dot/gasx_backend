# Online API is always tried first.
# Local Django is used only when the online server cannot be reached.

# Local fallback for browser and desktop development:
VITE_LOCAL_API_BASE_URL=http://127.0.0.1:8000/api/

# For an Android emulator, use this instead:
# VITE_LOCAL_API_BASE_URL=http://10.0.2.2:8000/api/

# Legacy alias: if VITE_LOCAL_API_BASE_URL is absent, VITE_API_BASE_URL is
# treated as the local fallback URL.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/

# Public map tile token; set this on the frontend build service.
VITE_JAWG_TOKEN=

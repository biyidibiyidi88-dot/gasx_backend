# Frontend Environment Configuration
# Copy this file to .env for local development

# API Base URL (optional - will auto-detect if not set)
# For local development: http://127.0.0.1:8000
# For production: https://gas-monitor-sfk3.onrender.com
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Development mode (automatically set by Vite)
# VITE_DEV=true

# Example configurations for different environments:

# Local development (auto-detected)
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Production/Deployed frontend (auto-detected)
# VITE_API_BASE_URL=https://gas-monitor-sfk3.onrender.com

# Custom backend URL (override auto-detection)
# VITE_API_BASE_URL=https://your-custom-backend.com

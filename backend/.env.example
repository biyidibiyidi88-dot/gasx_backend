# Environment Configuration for Gas Monitor Backend
# Copy this file to .env and fill in your actual values

# Django Configuration
DEBUG=False
SECRET_KEY=your-secret-key-here

# Database Configuration (use either DATABASE_URL or individual DB settings)
# For Render deployment, DATABASE_URL will be automatically provided
DATABASE_URL=postgresql://user:password@host:port/database

# Alternative: Individual database settings (for Supabase or other PostgreSQL)
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_supabase_password
DB_HOST=aws-0-eu-north-1.pooler.supabase.com
DB_PORT=6543

# Render Configuration (automatically set by Render)
RENDER_EXTERNAL_HOSTNAME=your-app-name.onrender.com

# Example Supabase Configuration:
# DB_NAME=postgres
# DB_USER=postgres.zwzojitihedgwqdnyenn
# DB_PASSWORD=XsFJN6nGwquuNr35
# DB_HOST=aws-0-eu-north-1.pooler.supabase.com
# DB_PORT=6543

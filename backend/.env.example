# Environment Configuration for Gas Monitor Backend
# Copy this file to .env and fill in your actual values

# Django Configuration
DEBUG=False
SECRET_KEY=your-secret-key-here

# Database Configuration (use either DATABASE_URL or individual DB settings)
# For Render deployment, DATABASE_URL will be automatically provided
DATABASE_URL=postgresql://user:password@host:port/database

# Optional file uploads through Supabase Storage (the database URL above is separate)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_BUCKET_NAME=profile-images

# Alternative: Individual database settings (for Supabase or other PostgreSQL)
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_supabase_password
DB_HOST=aws-0-eu-north-1.pooler.supabase.com
DB_PORT=6543

# Render Configuration (automatically set by Render)
RENDER_EXTERNAL_HOSTNAME=your-app-name.onrender.com

# DigiPay (keep this server-side; real pay-ins require production mode)
DIGIPAY_API_KEY=
DIGIPAY_ENVIRONMENT=sandbox
ALLOW_MOCK_PAYMENTS=false

# OpenRouter AI (keep the key on the Django server; never put it in a client app)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-haiku
OPENROUTER_FALLBACK_MODELS=mistralai/mistral-7b-instruct:free
OPENROUTER_SITE_URL=https://gasx.app
OPENROUTER_APP_NAME=GasX

# Optional: email notifications via Resend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Gas Monitor <onboarding@resend.dev>

# Example Supabase Configuration:
# DB_NAME=postgres
# DB_USER=postgres.zwzojitihedgwqdnyenn
